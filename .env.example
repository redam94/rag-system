# LLM Provider: ollama | openai | anthropic | google_vertexai
LLM_PROVIDER=ollama

# Model names (provider-specific)
LLM_MODEL=qwen3:30b
CODE_LLM_MODEL=qwen3-coder:30b
VISION_LLM_MODEL=qwen3-vl:30b

# Base URL (required for ollama, optional for openai-compatible endpoints)
LLM_BASE_URL=http://100.91.155.118:11434

# API Key (required for openai, anthropic; not needed for ollama)
# LLM_API_KEY=sk-...

# Workflow settings
MAX_RETRIES=3
VERIFY_ENABLED=true
MIN_QUALITY_SCORE=0.7
